# Template-owned: template-typescript. Versioning and CHANGELOG.md, from Conventional Commits.
#
# Every push to main updates one open "Release PR" that bumps the version and
# writes the CHANGELOG entry. A human reviews and merges it; that tags vX.Y.Z,
# publishes the GitHub Release[% if container_image %]; template-container's container-build.yml
# then builds the release image (it follows this workflow by its name, Release)[% endif %].
# See the wiki's Release-Process page.
#
# Token: PRs and tags made with GITHUB_TOKEN don't trigger other workflows, so
# CI would not run on the Release PR. Set the organisation variable
# RELEASE_APP_CLIENT_ID and secret RELEASE_APP_PRIVATE_KEY (a GitHub App with
# contents + pull-requests write) and this uses the App instead.
name: Release

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write
  issues: write

concurrency:
  group: release-please
  cancel-in-progress: false

jobs:
  release-please:
    runs-on: ubuntu-latest
    outputs:
      release_created: ${{ steps.release.outputs.release_created }}
      tag_name: ${{ steps.release.outputs.tag_name }}
      pr: ${{ steps.release.outputs.pr }}
    steps:
      - id: app-token
        if: vars.RELEASE_APP_CLIENT_ID != ''
        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0
        with:
          client-id: ${{ vars.RELEASE_APP_CLIENT_ID }}
          private-key: ${{ secrets.RELEASE_APP_PRIVATE_KEY }}

      - id: release
        uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7 # v5.0.0
        with:
          token: ${{ steps.app-token.outputs.token || github.token }}
          config-file: release-please-config.json
          manifest-file: .release-please-manifest.json

      # release-please 17.6.0, bundled in the pinned action, lists every issue a commit footer
      # names as ", closes" in the Release PR body, so merging the Release PR closes that issue.
      # This step says ", refs" instead. Upstream fixed it in release-please 17.10.4
      # (googleapis/release-please#2851): remove this step once the pinned action bundles it.
      - name: Keep the Release PR from closing issues
        if: steps.release.outputs.pr != ''
        env:
          GH_TOKEN: ${{ steps.app-token.outputs.token || github.token }}
          # The raw output, parsed in run: Actions evaluates env even when if: skips the step,
          # and fromJSON fails on the empty output of a run that opens no Release PR.
          PR_JSON: ${{ steps.release.outputs.pr }}
        run: |
          # jq is on GitHub's runners.
          PR=$(jq -r .number <<<"$PR_JSON")
          body=$(gh pr view "$PR" -R "$GITHUB_REPOSITORY" --json body --jq .body)
          fixed=${body//, closes /, refs }
          if [ "$body" = "$fixed" ]; then echo "Release PR #$PR closes no issues"; exit 0; fi
          printf '%s\n' "$fixed" | gh pr edit "$PR" -R "$GITHUB_REPOSITORY" --body-file -
          echo "Release PR #$PR: closes -> refs"
