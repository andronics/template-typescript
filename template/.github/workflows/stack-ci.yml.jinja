# Template-owned: template-typescript. The stack slot base-ci.yml's required `ci` job calls:
# the jobs that need the project installed. Cheap checks (the wiki standard, version and
# lock file) run in base-ci's `checks` job through scripts/checks.d/20-typescript.sh.
name: Stack

on:
  workflow_call:

permissions:
  contents: read

jobs:
[% set nodes = ['24', '26'] | select('ge', node_version) | list %]
  test:
    name: Test (Node.js ${{ matrix.node-version }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        node-version: [[ nodes | tojson ]]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: ${{ matrix.node-version }}
          cache: npm

      # The `build:` packages in contrib/system-packages.txt (project-owned), for
      # dependencies that build from source. None listed: nothing is installed.
      - name: System packages
        run: |
          if grep -q '^build:.*[^[:space:]]' contrib/system-packages.txt; then
            sudo apt-get update
            sed -n 's/^build://p' contrib/system-packages.txt | xargs sudo apt-get install -y --no-install-recommends
          fi

      # npm ci fails if package-lock.json is out of step with package.json: the lock check.
[% if kind != 'web' %]
      # It also builds dist/ (the prepare script).
[% endif %]
      - name: Install (from the lock file)
        run: npm ci --no-audit --no-fund

      - name: Lint
        run: npm run lint

      - name: Format
        run: npm run format:check

      - name: Type check
        run: npm run typecheck

      - name: Tests (with coverage floor)
        run: npm test

[% if kind == 'web' %]
      - name: Build (Vite)
        run: |
          npm run build
          test -f dist/index.html
[% else %]
      - name: Import and entry-point smoke test
        run: |
          node --input-type=module -e 'import { VERSION } from "[[ project_name ]]"; console.log("[[ project_name ]]", VERSION)'
[% if has_cli %]
          node dist/cli.js --help > /dev/null
[% endif %]
[% endif %]

      - name: Generated wiki sections are current
        if: matrix.node-version == '[[ node_version ]]'
        run: node scripts/gen-wiki.ts --check
[% if integration_ci %]

  # The Copier answer `integration_ci`: tests/integration/ (docs/decisions/0002 in
  # template-typescript). It fails, never passes vacuously, when none runs or one is
  # skipped (a missing package, device or service). On the minimum Node.js only.
  integration:
    name: Integration tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "[[ node_version ]]"
          cache: npm

      # Both lists in contrib/system-packages.txt: `build:` to install the dependencies,
      # `runtime:` for the tests to use them.
      - name: System packages
        run: |
          if grep -qE '^(build|runtime):.*[^[:space:]]' contrib/system-packages.txt; then
            sudo apt-get update
            sed -nE 's/^(build|runtime)://p' contrib/system-packages.txt | xargs sudo apt-get install -y --no-install-recommends
          fi

      - name: Install (from the lock file)
        run: npm ci --no-audit --no-fund

      # The script sets RUN_INTEGRATION=1. vitest passes with no tests in this mode
      # (passWithNoTests), so the next step reads its report. The coverage floor is the Test job's.
      - name: Integration tests
        run: npm run test:integration -- --reporter=default --reporter=junit --outputFile.junit="$RUNNER_TEMP/integration.xml"

      # vitest writes <skipped/> for skip, skipIf and todo; test.fails is a passed case.
      - name: An integration test ran, and none was skipped
        run: |
          python3 - "$RUNNER_TEMP/integration.xml" <<'EOF'
          import sys
          import xml.etree.ElementTree as ET
          from pathlib import Path

          report = Path(sys.argv[1])
          if not report.is_file():
              print(f"::error::no test report at {report}: vitest's junit reporter didn't run")
              sys.exit(1)
          cases = list(ET.parse(report).iter("testcase"))
          if not cases:
              print("::error::no integration test ran: add one to tests/integration/")
          skipped = [f"{case.get('classname')} > {case.get('name')}" for case in cases if case.find("skipped") is not None]
          for test in skipped:
              print(f"::error::skipped {test}")
          sys.exit(1 if skipped or not cases else 0)
          EOF
[% endif %]

  markdown:
    name: Markdown lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # The image, globs and config live in the script, so a local run matches this one.
      - name: markdownlint
        run: scripts/check-markdown.sh
[% if container_image or contrib %]

  manifests:
    name: Dockerfile and contrib manifests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install validators
        run: |
          mkdir -p "$HOME/.local/bin"
[% if container_image %]
          curl -fsSL -o "$HOME/.local/bin/hadolint" \
            https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-linux-x86_64
          chmod +x "$HOME/.local/bin/hadolint"
[% endif %]
[% if 'k8s' in contrib %]
          curl -fsSL https://github.com/yannh/kubeconform/releases/download/v0.8.0/kubeconform-linux-amd64.tar.gz \
            | tar -xz -C "$HOME/.local/bin" kubeconform
[% endif %]
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"
      - name: Validate
        run: scripts/check-manifests.sh
[% endif %]
