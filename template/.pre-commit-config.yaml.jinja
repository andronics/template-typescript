# Template-owned: template-typescript. The same checks as CI, before each commit:
#   uv tool install pre-commit && pre-commit install -t pre-commit -t commit-msg
repos:
  - repo: local
    hooks:
      - id: eslint
        name: eslint
        entry: npx eslint --fix --max-warnings 0
        language: system
        types_or: [ts, [% if kind == 'web' %]tsx, [% endif %]javascript]
      - id: prettier
        name: prettier
        entry: npx prettier --write
        language: system
        types_or: [ts, [% if kind == 'web' %]tsx, [% endif %]javascript]
      - id: tsc
        name: tsc
        entry: npx tsc --noEmit
        language: system
        types_or: [ts, [% if kind == 'web' %]tsx, [% endif %]javascript]
        pass_filenames: false
      - id: gen-wiki
        name: generated wiki sections
        entry: node scripts/gen-wiki.ts --check
        language: system
        pass_filenames: false
        files: ^(src/|docs/wiki/)
      # Every template's cheap checks: the stack contract, the wiki standard, version and lock.
      - id: checks
        name: scripts/checks.sh
        entry: sh scripts/checks.sh
        language: system
        pass_filenames: false
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks
  - repo: https://github.com/compilerla/conventional-pre-commit
    rev: v4.4.0
    hooks:
      - id: conventional-pre-commit
        stages: [commit-msg]
